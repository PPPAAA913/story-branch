# compose reads .env; local Python users must set environment variables themselves.
STUDIO_ALLOWED_HOSTS=localhost,127.0.0.1
STUDIO_COOKIE_SECURE=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Production HTTPS: set STUDIO_COOKIE_SECURE=1 and actual domain in STUDIO_ALLOWED_HOSTS.
# Model is configurable; verify account availability during real API integration.
